{
  "expo": {
    "name": "RentMe CRM",
    "slug": "rentme-crm-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rentme-crm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rentmeorlando.crm"
    },
    "android": {
      "package": "com.rentmeorlando.crm",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RentMe CRM to choose vehicle inspection photos.",
          "cameraPermission": "Allow RentMe CRM to take vehicle inspection photos."
        }
      ],
      "expo-image",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
